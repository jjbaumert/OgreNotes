# Copy to ogrenotes.env and fill in. Holds NO secrets except the AWS
# access key the server uses; everything else secret lives in SSM under
# SECRETS_SSM_PATH (setup.sh creates it). `chmod 600 ogrenotes.env`.

# ── AWS (the app's IAM user — iam/app-policy.json) ──
AWS_REGION=us-east-1
# Optional. Left out, the host's AWS profile OGRENOTES_AWS_PROFILE (in .env, default
# "default") is used instead.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Storage. Pick names nothing else uses (not the AWS test stack's). ──
# Table is "<prefix>ogrenote".
DYNAMODB_TABLE_PREFIX=home-
S3_BUCKET=

# ── Secrets: JWT_SECRET, OAUTH_CLIENT_SECRET, MFA_ENCRYPTION_KEY, and any of
# SMTP_PASSWORD / GOOGLE_CLIENT_SECRET / ANTHROPIC_API_KEY you use, stored
# as SecureStrings directly under this path. ──
SECRETS_SSM_PATH=/ogrenotes/home/secrets/

# ── Sign-in. A GitHub OAuth app whose callback is
# https://<OGRENOTES_DOMAIN>/api/v1/auth/callback (its secret goes in SSM
# as OAUTH_CLIENT_SECRET). For Google as well, set GOOGLE_CLIENT_ID and
# store GOOGLE_CLIENT_SECRET in SSM; its callback ends /callback/google. ──
OAUTH_CLIENT_ID=
# GOOGLE_CLIENT_ID=
# Emails that become admins on first sign-in.
ADMIN_EMAILS=

# ── Maintenance jobs (all run inside the server) ──
# Back the search index up to S3 hourly.
SEARCH_BACKUP_INTERVAL_MINS=60
# Hard-delete documents 30 days after they're trashed.
TRASH_CLEANUP_ENABLED=true
# Drop SecurityAudit rows after 90 days.
SECURITY_AUDIT_RETENTION_ENABLED=true
# Delete S3 objects whose document is gone. Starts in dry-run: read the
# "blob_reconcile dry-run: would delete" log lines for a few days, then set
# BLOB_RECONCILE_DRY_RUN=false.
BLOB_RECONCILE_ENABLED=true
BLOB_RECONCILE_DRY_RUN=true

# ── Email (optional). Without SMTP, notifications stay in-app. ──
# EMAIL_ENABLED=true
# EMAIL_FROM_ADDRESS=notes@example.com
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USERNAME=

# ── AI assistant (optional): store ANTHROPIC_API_KEY in SSM. ──
