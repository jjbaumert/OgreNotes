{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EditOneZone",
      "Effect": "Allow",
      "Action": ["route53:ChangeResourceRecordSets", "route53:ListResourceRecordSets"],
      "Resource": "arn:aws:route53:::hostedzone/__HOSTED_ZONE_ID__"
    },
    {
      "Sid": "FindZoneAndWaitForChanges",
      "Effect": "Allow",
      "Action": ["route53:ListHostedZones", "route53:ListHostedZonesByName", "route53:GetChange"],
      "Resource": "*"
    }
  ]
}
