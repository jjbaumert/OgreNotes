# Copy to caddy.env and fill in. `chmod 600 caddy.env`.
# A separate, DNS-only IAM user (iam/dns-policy.json) — the web server
# never holds the app's data credentials.
AWS_REGION=us-east-1
# Leave these out if CADDY_AWS_PROFILE in .env names a profile (./aws-creds.sh).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Let's Encrypt account email (expiry warnings go here).
ACME_EMAIL=
# The Route 53 hosted zone, and the record in it that should follow your
# public IP. For OGRENOTES_DOMAIN=notes.example.com: zone example.com,
# record notes. Use @ for the zone apex.
DNS_ZONE=example.com
DNS_RECORD=notes
