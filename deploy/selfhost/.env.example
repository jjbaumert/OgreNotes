# Copy to .env. Read by docker compose itself.
# The public name the server answers on — a record in your Route 53 zone.
OGRENOTES_DOMAIN=notes.example.com

# Optional: take AWS keys from profiles in the host's AWS config instead of
# ogrenotes.env / caddy.env. Run ./aws-creds.sh after setting these; it
# copies only the named profile for each service. Use the least-privileged
# IAM users (ogrenotes-app, ogrenotes-dns), never an admin profile. Unset
# means no host credentials for that service.
# OGRENOTES_AWS_PROFILE=ogrenotes-app
# CADDY_AWS_PROFILE=ogrenotes-dns
