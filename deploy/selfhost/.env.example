# Copy to .env. Read by docker compose itself.
# The public name the server answers on — a record in your Route 53 zone.
OGRENOTES_DOMAIN=notes.example.com

# AWS credentials fallback. When ogrenotes.env / caddy.env leave the
# access keys out, each service uses this profile from the host's AWS
# config ($HOME/.aws, mounted read-only). Point them at the least-privileged
# profiles you have (see iam/); "default" is often an admin profile.
# OGRENOTES_AWS_PROFILE=default
# CADDY_AWS_PROFILE=default
# AWS_DIR=/home/you/.aws
